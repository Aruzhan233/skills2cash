# --- AI (server-only; never prefix with NEXT_PUBLIC_) ---
# Required for live AI: assessment, offer/pricing coaching, AI client, evaluator, mission feedback.
# Without it, API routes return 503 and the UI offers clearly labelled offline samples.
OPENAI_API_KEY=
# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=
# Optional. Any OpenAI-compatible endpoint (must support JSON mode). Defaults to https://api.openai.com/v1
# e.g. Groq: https://api.groq.com/openai/v1 with OPENAI_MODEL=llama-3.3-70b-versatile
OPENAI_BASE_URL=

# --- Supabase (public, safe for the browser; access is restricted by Row Level Security) ---
# Required for accounts (sign up / log in) and cloud persistence.
# Without them the app runs in "local mode" (progress saved in the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
